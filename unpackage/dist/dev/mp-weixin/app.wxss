page {
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  background: #f5f5f5;
  --main-color: #6366f1;
  --text-color: #333;
  --text-light: #999;
  --bg-white: #fff;
  --radius: 16rpx;
}
.card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}
.trans {
  transition: all 0.3s ease;
}
button::after {
  border: none;
