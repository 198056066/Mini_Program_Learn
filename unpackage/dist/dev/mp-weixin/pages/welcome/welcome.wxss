
/* 整体容器：全屏渐变 + 初始透明，用于入场动画 */
.page.data-v-085f0530 {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(
    180deg,
    var(--main-color) 0%,
    rgba(var(--main-color-rgb), 0.45) 45%,
    #f5f6ff 100%
  );
  opacity: 0;
  transform: translateY(20rpx);
}

/* 入场动画触发类 */
.page.is-enter.data-v-085f0530 {
  animation: page-enter-085f0530 0.6s ease forwards;
}

/* 内容区：垂直/水平居中 */
.content.data-v-085f0530 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}

/* 标题区：居中对齐 */
.header.data-v-085f0530 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

/* 主标题：逐字动画承载容器 */
.title.data-v-085f0530 {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: center;
}

/* 单个字符：淡入上移 */
.title-char.data-v-085f0530 {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  opacity: 0;
  animation: title-fade-085f0530 0.6s ease forwards;
}

/* 副标题 */
.subtitle.data-v-085f0530 {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 图标容器 */
.icon-wrap.data-v-085f0530 {
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标本体：浮动动画 */
.icon.data-v-085f0530 {
  width: 180rpx;
  height: 180rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  animation: icon-float-085f0530 3s ease-in-out infinite;
}

/* 底部按钮区：贴近底部 */
.footer.data-v-085f0530 {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 主按钮：呼吸动画 + 按压缩放 */
.start-btn.data-v-085f0530 {
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--main-color);
  box-shadow: 0 10rpx 30rpx rgba(var(--main-color-rgb), 0.35);
  animation: btn-breathe-085f0530 1.8s ease-in-out infinite;
  transition: transform 0.15s ease;
}

/* 按下缩小反馈 */
.start-btn.data-v-085f0530:active {
  transform: scale(0.96);
}

/* 次按钮：轻量样式 */
.ghost-btn.data-v-085f0530 {
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--main-color);
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(var(--main-color-rgb), 0.25);
  transition: transform 0.15s ease;
}

/* 次按钮按压反馈 */
.ghost-btn.data-v-085f0530:active {
  transform: scale(0.96);
}

/* 页面入场动画：淡入 + 上移 */
@keyframes page-enter-085f0530 {
from {
    opacity: 0;
    transform: translateY(20rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}

/* 标题逐字动画 */
@keyframes title-fade-085f0530 {
from {
    opacity: 0;
    transform: translateY(10rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}

/* 图标浮动动画 */
@keyframes icon-float-085f0530 {
0%,
  100% {
    transform: translateY(0);
}
50% {
    transform: translateY(-10rpx);
}
}

/* 按钮呼吸动画 */
@keyframes btn-breathe-085f0530 {
0%,
  100% {
    transform: scale(1);
    box-shadow: 0 10rpx 30rpx rgba(var(--main-color-rgb), 0.35);
}
50% {
    transform: scale(1.03);
    box-shadow: 0 14rpx 40rpx rgba(var(--main-color-rgb), 0.45);
}
}
