
.page.data-v-018cdf56 {
  --main-color: var(--48a0885f);
  --main-color-rgb: var(--9d423024);
}
.page.data-v-018cdf56 {
  min-height: 100vh;
  padding: 80rpx 32rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.nav.data-v-018cdf56 {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.nav-btn.data-v-018cdf56 {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: var(--main-color);
  font-size: 24rpx;
  border: 2rpx solid rgba(var(--main-color-rgb), 0.25);
  text-align: center;
}
.nav-btn.primary.data-v-018cdf56 {
  background: var(--main-color);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(var(--main-color-rgb), 0.25);
}
.title.data-v-018cdf56 {
  font-size: 32rpx;
  font-weight: 700;
}
.section.data-v-018cdf56 {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.label.data-v-018cdf56 {
  font-weight: 600;
}
.palette.data-v-018cdf56 {
  display: flex;
  gap: 16rpx;
}
.color.data-v-018cdf56 {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/* 选中态：外圈高亮 + 轻微放大 */
.color.active.data-v-018cdf56 {
  transform: scale(1.08);
  box-shadow: 0 0 0 6rpx rgba(var(--main-color-rgb), 0.25);
}
